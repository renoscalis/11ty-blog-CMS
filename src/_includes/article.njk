--- 
layout: 'base.njk'
---       
<article class="main-article">
<div class="container container--narrow flow">
  
    <h1 class="article-title">
      {{ title }}
    </h1>
    <figure class="main-article__figure">
      <img src="{{ image }}" alt="{{ imageAlt }}">
      
      <!-- Προαιρετικό, αν θέλουμε να βάλουμε λεζάντα μπορούμε να το κάνουμε να παίρνει αυτόματα το alt της εικόνας -->
      <figcaption>
        {{ imageAlt }}
      </figcaption>
    </figure>
    
    {{ content | safe }}
  
</div>
</article>